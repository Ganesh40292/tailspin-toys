---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import ArrowLeft from '../assets/icons/arrow-left.svg';
---

<Layout title="Page Not Found - Tailspin Toys">
  <div class="py-10 sm:py-16">
    <Card as="section" class="mx-auto max-w-xl p-8 text-center shadow-lg shadow-slate-950/30 sm:p-12" data-testid="not-found">
      <p class="text-7xl font-bold tracking-tight text-blue-400">404</p>
      <h1 class="mt-4 mb-3 text-2xl font-bold text-white" data-testid="not-found-heading">Page not found</h1>
      <p class="mb-8 leading-7 text-slate-400" data-testid="not-found-text">
        We couldn&apos;t find the page you were looking for. It may have been removed or the link is incorrect.
      </p>
      <Button href="/" data-testid="not-found-home-link">
        <ArrowLeft class="h-5 w-5 mr-2" aria-hidden="true" />
        Back to all games
      </Button>
    </Card>
  </div>
</Layout>
