---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';

interface Props {
  /** The selected tier is read from the static form query string for a friendly confirmation. */
  tier?: string;
}

const tier = Astro.url.searchParams.get('tier') ?? 'Supporter';
---
<Layout title="Pledge Confirmed - Tailspin Toys">
  <Card as="section" class="mx-auto max-w-2xl p-8 text-center sm:p-12" data-testid="pledge-confirmation">
    <p class="text-5xl" aria-hidden="true">✨</p>
    <h1 class="mt-4 text-3xl font-bold text-white" data-testid="confirmation-heading">Thanks for backing the demo!</h1>
    <p class="mt-4 leading-7 text-slate-300">Your simulated <strong class="text-blue-200">{tier}</strong> pledge is recorded locally for this preview. No payment was processed.</p>
    <Button href="/" class="mt-8" data-testid="confirmation-home">Explore more campaigns</Button>
  </Card>
</Layout>
