---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
    /** HTML element to render the panel as (e.g. 'div', 'section', 'article'). */
    as?: 'div' | 'section' | 'article' | 'aside';
}

const { as = 'div', class: className, ...rest } = Astro.props;
const Element = as;
---

<Element class:list={['rounded-2xl border border-slate-800/90 bg-slate-900/75 shadow-xl shadow-slate-950/20 backdrop-blur-sm', className]} {...rest}>
    <slot />
</Element>
