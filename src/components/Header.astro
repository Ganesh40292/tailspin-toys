---
import Menu from '../assets/icons/menu.svg';
---

<header class="sticky top-0 z-40 border-b border-blue-400/15 bg-slate-950/85 text-white shadow-lg shadow-slate-950/20 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <div class="relative group">
        <button type="button" id="menu-toggle" data-testid="menu-toggle" class="rounded-lg border border-slate-700 bg-slate-900/80 p-2 text-slate-300 transition-all hover:border-blue-400/60 hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="absolute left-0 mt-3 hidden w-52 rounded-xl border border-slate-700 bg-slate-900 text-slate-100 shadow-2xl shadow-slate-950/50">
          <ul class="p-2">
            <li><a href="/" data-testid="nav-home" class="block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-slate-800 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400">Home</a></li>
            <li><a href="/about" data-testid="nav-about" class="block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-slate-800 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400">About</a></li>
          </ul>
        </nav>
      </div>
      <div>
        <a href="/" data-testid="brand-link" class="text-lg font-bold tracking-tight text-white transition-colors hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950 sm:text-xl">Tailspin Toys</a>
        <p class="hidden text-xs text-slate-400 sm:block">Crowdfunding better game nights</p>
      </div>
    </div>
  </div>
</header>

<script>
  const initialiseMenu = (): void => {
    const menuToggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('menu');

    if (!menuToggle || !menu || menuToggle.dataset.initialised === 'true') return;
    menuToggle.dataset.initialised = 'true';

    const toggleMenu = (): void => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    };

    menuToggle.addEventListener('click', toggleMenu);

    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });

  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseMenu, { once: true });
  } else {
    initialiseMenu();
  }
</script>