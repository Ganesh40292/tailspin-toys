---
interface Props {
    text?: string;
}

const { text } = Astro.props;
---

<div
    data-testid="empty-state"
    class="rounded-2xl border border-slate-800 bg-slate-900/70 px-6 py-14 text-center shadow-lg shadow-slate-950/20 backdrop-blur-sm"
>
    {text ? (
        <p data-testid="empty-state-text" class="text-lg text-slate-300">{text}</p>
    ) : (
        <slot />
    )}
</div>
