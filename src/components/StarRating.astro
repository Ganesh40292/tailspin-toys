---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

{rating !== null && (
    <div class="flex min-h-11 items-center" role="img" aria-label={`Rating ${clampRating(rating).toFixed(1)} out of 5 stars`}>
        <span class="rounded-full border border-amber-400/15 bg-amber-400/10 px-3 py-1 text-sm font-semibold text-amber-200" data-testid="game-rating">
            <span class="text-yellow-400">{formatStarRating(rating)}</span>
            {clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
