---
import type { Game } from '../types/game';
import Tag from './Tag.astro';
import StarRating from './StarRating.astro';
import ArrowRight from '../assets/icons/arrow-right.svg';

interface Props {
    game: Game;
}

const { game } = Astro.props;
---

<a
    href={`/game/${game.id}`}
    class="group block overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/75 shadow-lg shadow-slate-950/20 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-400/50 hover:shadow-xl hover:shadow-blue-950/30 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950"
    data-testid="game-card"
    data-game-id={game.id}
    data-game-title={game.title}
    data-game-rating={game.starRating ?? ''}
    data-game-description={game.description}
    data-game-category={game.category?.name ?? ''}
    data-game-publisher={game.publisher?.name ?? ''}
    data-category-id={game.category?.id}
    data-publisher-id={game.publisher?.id}
>
    <div class="relative p-6">
        <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-br from-blue-500/15 to-transparent opacity-60 transition-opacity duration-300 group-hover:opacity-100"></div>
        <div class="relative z-10">
            <div class="mb-5 flex items-start justify-between gap-4">
              <h3 class="text-xl font-semibold leading-tight text-slate-100 transition-colors group-hover:text-blue-300" data-testid="game-title">{game.title}</h3>
              <span class="text-slate-600 transition-colors group-hover:text-blue-400" aria-hidden="true">↗</span>
            </div>

            {(game.category?.name || game.publisher?.name) && (
                <div class="mb-4 flex flex-wrap gap-2">
                    {game.category?.name && (
                        <Tag color="blue" data-testid="game-category">
                            {game.category.name}
                        </Tag>
                    )}
                    {game.publisher?.name && (
                        <Tag color="purple" data-testid="game-publisher">
                            {game.publisher.name}
                        </Tag>
                    )}
                </div>
            )}

            <p class="mb-5 line-clamp-2 text-sm leading-6 text-slate-400" data-testid="game-description">{game.description}</p>

            {game.starRating !== null ? (
                <StarRating rating={game.starRating} />
            ) : (
                <div class="text-slate-400 text-sm mb-4" data-testid="game-rating">No rating yet</div>
            )}

            <div class="mt-5 flex items-center text-sm font-semibold text-blue-400">
                <span>View details</span>
                <ArrowRight class="h-4 w-4 ml-1 transform transition-transform duration-300 group-hover:translate-x-2" aria-hidden="true" />
            </div>
        </div>
    </div>
</a>
