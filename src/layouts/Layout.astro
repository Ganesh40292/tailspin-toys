---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  /** Document title rendered in the browser tab. */
  title?: string;
}

const { title = 'Tailspin Toys' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
        <Header />
        <main class="relative isolate overflow-hidden">
            <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(circle_at_top,_rgba(37,99,235,0.16),_transparent_62%)]"></div>
            <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-14">
                <slot />
            </div>
        </main>
        <footer class="border-t border-slate-800/80 bg-slate-950/80">
            <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
                <p>Built for bold ideas and better game nights.</p>
                <a href="/about" data-testid="footer-about-link" class="font-medium text-slate-400 transition-colors hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950">About Tailspin Toys</a>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
        background: #020617;
    }

    ::selection {
        background: rgb(37 99 235 / 0.45);
        color: #f8fafc;
    }
</style>
